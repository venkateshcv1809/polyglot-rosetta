root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Python (PEP 8 standard)
[*.py]
indent_style = space
indent_size = 4

# TypeScript & Web Ecosystem
[*.{ts,tsx,json,md,yaml,yml}]
indent_style = space
indent_size = 2

# Go (Strictly tabs according to gofmt)
[*.go]
indent_style = tab
tab_width = 4

# Rust
[*.rs]
indent_style = space
indent_size = 4

# Zig
[*.zig]
indent_style = space
indent_size = 4