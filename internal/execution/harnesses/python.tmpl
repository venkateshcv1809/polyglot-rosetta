import json
import sys
import time
from solution import Solution

inputs = json.loads({{.Inputs}})
result_marker = {{.Marker}}
index = int(sys.argv[1])
input_data = inputs[index]
solution = Solution()
started = time.perf_counter_ns()
actual = solution.solve(input_data)
elapsed = time.perf_counter_ns() - started
output = json.dumps(actual, ensure_ascii=True, allow_nan=False).encode("utf-8")
print(f"\n{result_marker}:{index}:{elapsed}:json:{output.hex()}")
