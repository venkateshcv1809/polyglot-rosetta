const std = @import("std");
const builtin = @import("builtin");
const Solution = @import("solution.zig").Solution;

fn monotonicNs() i128 {
    if (builtin.os.tag == .wasi) {
        var timestamp: std.os.wasi.timestamp_t = undefined;
        if (std.os.wasi.clock_time_get(.MONOTONIC, 1, &timestamp) != .SUCCESS) @panic("monotonic clock unavailable");
        return @intCast(timestamp);
    }
    var timestamp: std.c.timespec = undefined;
    if (std.c.clock_gettime(.MONOTONIC, &timestamp) != 0) @panic("monotonic clock unavailable");
    return @as(i128, timestamp.sec) * 1_000_000_000 + @as(i128, timestamp.nsec);
}

pub fn main(init: std.process.Init.Minimal) !void {
    var arena = std.heap.ArenaAllocator.init(std.heap.page_allocator);
    defer arena.deinit();
    const allocator = arena.allocator();
    var args = try std.process.Args.Iterator.initAllocator(init.args, allocator);
    defer args.deinit();
    _ = args.skip();
    const index = try std.fmt.parseUnsigned(usize, args.next() orelse return error.MissingTestCaseIndex, 10);
    const input_text: []const u8 = switch (index) {
    {{range .Cases}}{{.Index}} => &[_]u8{{.Input}},
    {{end}}else => return error.InvalidTestCaseIndex,
    };
    const text_output = switch (index) {
    {{range .Cases}}{{.Index}} => {{.TextOutput}},
    {{end}}else => unreachable,
    };
    const parsed = try std.json.parseFromSlice(std.json.Value, allocator, input_text, .{});
    defer parsed.deinit();
    const started = monotonicNs();
    const actual = try Solution.solve(allocator, parsed.value);
    const elapsed = monotonicNs() - started;
    const format: []const u8 = if (text_output) "text" else "json";
    const digits = "0123456789abcdef";
    const hex = try allocator.alloc(u8, actual.len * 2);
    for (actual, 0..) |byte, i| {
        hex[2 * i] = digits[byte >> 4];
        hex[2 * i + 1] = digits[byte & 15];
    }
    std.debug.print("\n{s}:{d}:{d}:{s}:{s}\n", .{ {{.Marker}}, index, elapsed, format, hex });
}
